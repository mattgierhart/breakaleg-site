{
  "name": "breakaleg-site",
  "version": "1.0.0",
  "private": true,
  "description": "Break a Leg website and show-code service (Cloudflare Pages + Functions + KV). The site itself is plain static HTML.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dev": "wrangler pages dev . --kv SHOWS --persist-to .wrangler/state --compatibility-date 2024-09-23",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "wrangler": "4.169.0"
  }
}
